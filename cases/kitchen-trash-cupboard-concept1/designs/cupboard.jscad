const boxPart = (part) => {
  const center = [
    part.pos[0] + part.size[0] / 2,
    part.pos[1] + part.size[1] / 2,
    part.pos[2] + part.size[2] / 2
  ]
  return translate(center, colorize(part.color, cuboid({ size: part.size })))
}

const main = () => union(parts.map(boxPart))

module.exports = { main, parts }
